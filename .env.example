# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# A replica set (or Atlas) is required for MongoDB transactions. On a standalone
# mongod the app automatically falls back to sequential writes with compensating
# rollback — see src/lib/db/transaction.ts.
MONGODB_URI="mongodb://127.0.0.1:27017/hospital_crm"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Two INDEPENDENT secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters each; the app refuses to boot with shorter secrets.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"

# Token lifetimes (seconds). Access token stays short so a stale tokenVersion
# can never outlive one refresh cycle.
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=2592000     # 30 days

JWT_ISSUER="hospital-crm"
JWT_AUDIENCE="hospital-crm-app"

# ---------------------------------------------------------------------------
# Seed (creates the initial platform Super Admin)
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="superadmin@platform.local"
SUPER_ADMIN_PASSWORD="ChangeMe!2024"
SUPER_ADMIN_NAME="Platform Super Admin"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Applied to every API route. Authenticated callers are counted per user;
# everyone else per client IP. The tighter limiters on login, refresh and
# password change sit on top of these and are unaffected.
#
# State is in-process, so these are per-instance figures — behind several
# replicas the effective limit is N x the value. See src/lib/security/rate-limit.ts.
RATE_LIMIT_ENABLED="true"     # exactly "true" or "false"
RATE_LIMIT_WINDOW=60          # seconds, shared by all three tiers
RATE_LIMIT_READ=300           # authenticated GET/HEAD, per user
RATE_LIMIT_WRITE=120          # authenticated POST/PATCH/PUT/DELETE, per user
RATE_LIMIT_UNAUTH=120         # no valid session, per IP

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Set to "production" to force Secure cookies. In development cookies are issued
# without the Secure flag so they work over plain http://localhost.
NODE_ENV="development"


